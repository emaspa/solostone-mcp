<Project Sdk="Microsoft.NET.Sdk">
  <!-- AssemblyName EngineProof: the engine trusts it with internals (InternalsVisibleTo). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EngineProof</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0168;CS0219;CS8321</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EngineDir)/engine/SabberStoneCore/SabberStoneCore.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
